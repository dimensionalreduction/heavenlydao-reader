{
  "manifest_version": 3,
  "name": "heavenlydao.com Reader",
  "version": "1.0.8",
  "description": "Fetch web-novel chapters, translate them with Gemini, and keep them in your heavenlydao.com library on all your devices.",
  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  },
  "permissions": [
    "activeTab",
    "cookies",
    "scripting",
    "storage",
    "tabs",
    "notifications",
    "offscreen",
    "alarms",
    "unlimitedStorage",
    "background"
  ],
  "host_permissions": [
    "https://generativelanguage.googleapis.com/*",
    "https://translate.googleapis.com/*",
    "https://wtr-lab.com/*",
    "https://*.69shuba.com/*",
    "https://*.twkan.com/*",
    "https://*.novel543.com/*",
    "https://*.twbook.cc/*",
    "https://*.uuread.tw/*",
    "https://*.piaotia.com/*",
    "https://*.trxs.cc/*",
    "https://*.tongrenshe.cc/*",
    "https://*.uukanshu.cc/*",
    "https://*.bixiange.xyz/*",
    "https://*.ffxs8.com/*",
    "https://*.biquge.tw/*",
    "https://*.101kks.com/*",
    "https://*.101kanshu.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://p2p-library.pages.dev/*",
        "https://heavenlydao.com/*",
        "https://www.heavenlydao.com/*"
      ],
      "js": [
        "site-bridge.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://wtr-lab.com/*"
      ],
      "js": [
        "wtr-terms.js",
        "wtr-capture.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.69shuba.com/book/*",
        "https://69shuba.com/book/*"
      ],
      "js": [
        "chapter-index.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "optional_host_permissions": ["https://*/*"],
  "web_accessible_resources": [
    { "resources": ["access.html", "access.js", "site-access.js"], "matches": ["https://p2p-library.pages.dev/*", "https://heavenlydao.com/*", "https://www.heavenlydao.com/*"] }
  ],
  "options_ui": { "page": "rules.html", "open_in_tab": true },
  "action": {
    "default_title": "heavenlydao.com Reader",
    "default_icon": {
      "16": "icon-16.png",
      "32": "icon-32.png"
    },
    "default_popup": "popup.html"
  }
}
