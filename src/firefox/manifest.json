{
  "manifest_version": 2,
  "name": "heavenlydao.com Reader",
  "version": "1.0.8",
  "browser_specific_settings": {
    "gecko": {
      "id": "reader@heavenlydao.com",
      "strict_min_version": "140.0",
      "data_collection_permissions": { "required": ["websiteContent"] }
    },
    "gecko_android": { "strict_min_version": "142.0" }
  },
  "description": "Fetch web-novel chapters, translate them with Gemini, and keep them in your heavenlydao.com library on all your devices.",
  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  },
  "permissions": [
    "activeTab",
    "cookies",
    "storage",
    "tabs",
    "notifications",
    "https://generativelanguage.googleapis.com/*",
    "https://translate.googleapis.com/*",
    "https://wtr-lab.com/*",
    "https://*.69shuba.com/*",
    "https://*.twkan.com/*",
    "https://*.novel543.com/*",
    "https://*.twbook.cc/*",
    "https://*.uuread.tw/*",
    "https://*.piaotia.com/*",
    "https://*.trxs.cc/*",
    "https://*.tongrenshe.cc/*",
    "https://*.uukanshu.cc/*",
    "https://*.bixiange.xyz/*",
    "https://*.ffxs8.com/*",
    "https://*.biquge.tw/*",
    "https://*.101kks.com/*",
    "https://*.101kanshu.com/*",
    "unlimitedStorage"
  ],
  "optional_permissions": ["https://*/*"],
  "web_accessible_resources": ["access.html", "access.js", "site-access.js"],
  "options_ui": { "page": "rules.html", "open_in_tab": true },
  "background": {
    "scripts": [
      "webtorrent.min.js",
      "site-matches.js",
      "site-access.js",
      "access-offer.js",
      "fish-speech.js",
      "p2p-core.js",
      "glossary-server.js",
      "term-match.js",
      "gemini.js",
      "wtr-terms.js",
      "raw-sources.js",
      "user-rules.js",
      "base-glossary.js",
      "term-pool.js",
      "pool-hints.js",
      "pool-share.js",
      "term-notes.js",
      "profile-model.js",
      "profile-translate.js",
      "lang-detect.js",
      "original-translate.js",
      "watcher.js",
      "book-visit.js",
      "background.js",
      "book-capture.js",
      "library-api.js",
      "library.js",
      "share-rooms.js",
      "follow-host.js",
      "chapters.js",
      "share-lists.js",
      "library-host.js",
      "notify.js",
      "notice-host.js",
      "notice-bg.js",
      "p2p-host.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "https://p2p-library.pages.dev/*",
        "https://heavenlydao.com/*",
        "https://www.heavenlydao.com/*"
      ],
      "js": [
        "site-bridge.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://wtr-lab.com/*"
      ],
      "js": [
        "wtr-terms.js",
        "wtr-capture.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.69shuba.com/book/*",
        "https://69shuba.com/book/*"
      ],
      "js": [
        "chapter-index.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "browser_action": {
    "default_title": "heavenlydao.com Reader",
    "default_icon": {
      "16": "icon-16.png",
      "32": "icon-32.png"
    },
    "default_popup": "popup.html"
  }
}
